<?xml version="1.0"?>
<package format="3">
  <name>tag_detection</name>
  <version>0.0.0</version>
  <description>AprilTag pose publisher + cube color detector for IR assignment 2</description>

  <maintainer email="prakash@todo.todo">prakash</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>

  <!-- TF2 (required by apriltag_pose_publisher) -->
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- OpenCV via CMake -->
  <exec_depend>opencv</exec_depend>

  <!-- System AprilTag (installed via apt: libapriltag-dev) -->
  <exec_depend>libapriltag-dev</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

